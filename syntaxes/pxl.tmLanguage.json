{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Pixelate",
    "scopeName": "source.pxl",
    "patterns": [
        { "include": "#comments" },
        { "include": "#formatted-strings" },
        { "include": "#strings" },
        { "include": "#declarations" },
        { "include": "#methods" },
        { "include": "#keywords" },
        { "include": "#element-types" },
        { "include": "#properties" },
        { "include": "#types" },
        { "include": "#literals" },
        { "include": "#numbers" },
        { "include": "#identifiers" }
    ],
    "repository": {
        "comments": {
            "name": "comment.line.number-sign.pxl",
            "match": "#.*$"
        },
        "strings": {
            "name": "string.quoted.double.pxl",
            "begin": "\"",
            "end": "\"",
            "patterns": [
                {
                    "name": "constant.character.escape.pxl",
                    "match": "\\\\(n|t|\\\\|\")"
                }
            ]
        },
        "formatted-strings": {
            "name": "string.quoted.double.pxl",
            "begin": "\\bf\"",
            "end": "\"",
            "patterns": [
                {
                    "name": "constant.character.escape.pxl",
                    "match": "\\\\(n|t|\\\\|\")"
                },
                {
                    "name": "meta.interpolation.pxl",
                    "begin": "\\{",
                    "end": "\\}",
                    "patterns": [
                        {
                            "name": "variable.other.readwrite.pxl",
                            "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?:\\.[a-zA-Z_][a-zA-Z0-9_]*)?\\b"
                        }
                    ]
                }
            ]
        },
        "declarations": {
            "name": "keyword.control.block.pxl",
            "match": "\\b(window|label|par|button|textbox|textarea|rect|circle|triangle|trigger)\\b"
        },
        "methods": {
            "patterns": [
                {
                    "name": "support.function.pxl",
                    "match": "\\b(add|remove|update|run|switch_view|add_view|print|println)\\b(?=\\s*\\()"
                },
                {
                    "name": "keyword.control.pxl",
                    "match": "\\b(if|else|while|for)\\b"
                },
                {
                    "name": "keyword.control.event.pxl",
                    "match": "\\b(onkey|onkeyci|mouseMove|closeTrigger)\\b"
                }
            ]
        },
        "keywords": {
            "name": "keyword.control.pxl",
            "match": "\\b(trigger)\\b"
        },
        "element-types": {
            "name": "support.class.widget.pxl",
            "match": "\\b(label|par|button|textbox|textarea)\\b"
        },
        "properties": {
            "name": "entity.other.attribute-name.pxl",
            "match": "\\b(title|width|height|background|iconPath|text|placeholder|x|y|font|fontSize|angle|radius|p1|p2|p3)\\b(?=\\s*:)"
        },
        "values": {
            "name": "constant.language.pxl",
            "match": "\\b(DEFAULT|ARIAL|CALIBRI|CONSOLAS|COURIERNEW|TIMESNEWROMAN|TAHOMA|VERDANA|ARROW|IBEAM|WAIT|CROSS|UPARROW|SIZE|ICON|SIZENWSE|SIZENESW|SIZEWE|SIZENS|SIZEALL|NO|HAND|APPSTARTING|HELP|PIN|PERSON)\\b"
        },
        "types": {
            "name": "storage.type.pxl",
            "match": "\\b(int|short|long|float|double|bool|char|String)\\b"
        },
        "literals": {
            "patterns": [
                {
                    "name": "constant.language.boolean.pxl",
                    "match": "\\b(true|false)\\b"
                },
                {
                    "name": "constant.character.pxl",
                    "match": "'(?:\\\\.|[^'\\\\])'"
                }
            ]
        },
        "numbers": {
            "name": "constant.numeric.pxl",
            "match": "\\b-?\\d+(?:\\.\\d+)?\\b"
        },
        "identifiers": {
            "name": "variable.other.readwrite.pxl",
            "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
    }
}
